#!/usr/bin/env bun

type Shape = Record<string, unknown>;

const readInput = async (file: string | undefined): Promise<string> =>
  file ? await Bun.file(file).text() : await new Response(Bun.stdin.stream()).text();

const parseArguments = (): { depth: number; file?: string } => {
  const args = Bun.argv.slice(2);
  let depth = 2;
  let file: string | undefined;
  for (let index = 0; index < args.length; index += 1) {
    const argument = args[index];
    if (argument === "--depth" || argument === "-d") {
      const value = Number(args[index + 1]);
      if (Number.isInteger(value) && value >= 0) {
        depth = value;
      }
      index += 1;
    } else if (argument.startsWith("--depth=")) {
      const value = Number(argument.split("=", 2)[1]);
      if (Number.isInteger(value) && value >= 0) {
        depth = value;
      }
    } else if (!argument.startsWith("-")) {
      file = argument;
    }
  }
  return { depth, file };
};

const valueType = (value: unknown): string => {
  if (value === null) {
    return "null";
  }
  if (Array.isArray(value)) {
    return "array";
  }
  return typeof value;
};

const shallowShape = (value: unknown): Shape => {
  const type = valueType(value);
  if (type === "string") {
    return { type, length: (value as string).length };
  }
  if (type === "array") {
    return { type, length: (value as unknown[]).length };
  }
  if (type === "object") {
    return { type: "object" };
  }
  return { type };
};

const describe = (value: unknown, remainingDepth: number): Shape => {
  const type = valueType(value);
  if (type === "string") {
    return { type, length: (value as string).length };
  }
  if (type === "array") {
    const array = value as unknown[];
    const shape: Shape = { type, length: array.length };
    if (array.length > 0) {
      shape.sample =
        remainingDepth > 0 ? describe(array[0], remainingDepth - 1) : shallowShape(array[0]);
    }
    return shape;
  }
  if (type === "object") {
    const object = value as Record<string, unknown>;
    const keys = Object.keys(object);
    if (remainingDepth === 0) {
      return { type, keys };
    }
    return {
      type,
      keys: Object.fromEntries(
        keys.map((key) => [key, describe(object[key], remainingDepth - 1)])
      ),
    };
  }
  return { type };
};

const { depth, file } = parseArguments();
const input = await readInput(file);
const value: unknown = JSON.parse(input);
process.stdout.write(`${JSON.stringify(describe(value, depth), null, 2)}\n`);
